{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Project Id",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "snapshot_id"
      ],
      "title": "Ref",
      "type": "object"
    },
    "RelationAuthorityContext": {
      "additionalProperties": false,
      "properties": {
        "left_authority": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Left Authority",
          "type": "array"
        },
        "left_lifecycle": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Left Lifecycle",
          "type": "array"
        },
        "right_authority": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Right Authority",
          "type": "array"
        },
        "right_lifecycle": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Right Lifecycle",
          "type": "array"
        }
      },
      "required": [
        "left_authority",
        "right_authority",
        "left_lifecycle",
        "right_lifecycle"
      ],
      "title": "RelationAuthorityContext",
      "type": "object"
    }
  },
  "$id": "urn:qe-skill:1.0:semantic-relation",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_changed": {
      "const": false,
      "default": false,
      "title": "Authority Changed",
      "type": "boolean"
    },
    "authority_context": {
      "$ref": "#/$defs/RelationAuthorityContext"
    },
    "confidence_used_to_select_winner": {
      "const": false,
      "default": false,
      "title": "Confidence Used To Select Winner",
      "type": "boolean"
    },
    "deployment_record": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Id",
      "type": "string"
    },
    "left": {
      "$ref": "#/$defs/Ref"
    },
    "left_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Left Hash",
      "type": "string"
    },
    "project_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Project Id",
      "type": "string"
    },
    "provider_candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provider_candidate_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Candidate Hash"
    },
    "provider_candidate_relation": {
      "anyOf": [
        {
          "enum": [
            "CONSISTENT",
            "CONFLICTING",
            "REFINEMENT",
            "SUPERSEDED",
            "DEPLOYMENT_INSTANCE",
            "AMBIGUOUS",
            "HUMAN_DECISION_REQUIRED"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Candidate Relation"
    },
    "rationale_codes": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "minItems": 1,
      "title": "Rationale Codes",
      "type": "array"
    },
    "refinement_record": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "relation": {
      "enum": [
        "CONSISTENT",
        "CONFLICTING",
        "REFINEMENT",
        "SUPERSEDED",
        "DEPLOYMENT_INSTANCE",
        "AMBIGUOUS",
        "HUMAN_DECISION_REQUIRED"
      ],
      "title": "Relation",
      "type": "string"
    },
    "right": {
      "$ref": "#/$defs/Ref"
    },
    "right_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Right Hash",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Snapshot Id",
      "type": "string"
    },
    "superseded_record": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "project_id",
    "snapshot_id",
    "left",
    "left_hash",
    "right",
    "right_hash",
    "relation",
    "rationale_codes",
    "authority_context"
  ],
  "title": "SemanticRelation",
  "type": "object"
}
