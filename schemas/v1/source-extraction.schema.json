{
  "$defs": {
    "ExtractionRecord": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Attributes",
          "type": "object"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "extraction_method": {
          "minLength": 1,
          "title": "Extraction Method",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "inferred": {
          "title": "Inferred",
          "type": "boolean"
        },
        "interpretation": {
          "enum": [
            "explicit",
            "structural",
            "heuristic",
            "unresolved"
          ],
          "title": "Interpretation",
          "type": "string"
        },
        "kind": {
          "enum": [
            "heading",
            "paragraph",
            "list_item",
            "code_fence",
            "structured_value",
            "openapi_operation",
            "openapi_parameter",
            "openapi_response",
            "openapi_schema",
            "openapi_security",
            "python_module",
            "python_class",
            "python_function",
            "python_async_function",
            "python_import",
            "python_decorator",
            "project_model_record"
          ],
          "title": "Kind",
          "type": "string"
        },
        "location": {
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "project_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Project Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Snapshot Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Ref"
        },
        "source_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "snapshot_id",
        "source",
        "source_hash",
        "kind",
        "location",
        "text",
        "extraction_method",
        "interpretation",
        "inferred",
        "confidence"
      ],
      "title": "ExtractionRecord",
      "type": "object"
    },
    "JsonValue": {},
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Project Id",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "snapshot_id"
      ],
      "title": "Ref",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "column_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column End"
        },
        "column_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column Start"
        },
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "line_end": {
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "project_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Project Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Snapshot Id",
          "type": "string"
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        }
      },
      "required": [
        "id",
        "project_id",
        "snapshot_id",
        "line_start",
        "line_end"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "$id": "urn:qe-skill:1.0:source-extraction",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "extractions": {
      "items": {
        "$ref": "#/$defs/ExtractionRecord"
      },
      "title": "Extractions",
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Id",
      "type": "string"
    },
    "issues": {
      "items": {
        "type": "string"
      },
      "title": "Issues",
      "type": "array"
    },
    "parser": {
      "minLength": 1,
      "title": "Parser",
      "type": "string"
    },
    "parser_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Parser Version",
      "type": "string"
    },
    "project_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Snapshot Id",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Ref"
    },
    "source_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Hash"
    },
    "source_type": {
      "minLength": 1,
      "title": "Source Type",
      "type": "string"
    },
    "status": {
      "enum": [
        "PARSED",
        "PARTIAL",
        "FAILED",
        "UNSUPPORTED",
        "MUTATED"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "id",
    "project_id",
    "snapshot_id",
    "source",
    "source_type",
    "parser",
    "status",
    "extractions",
    "issues"
  ],
  "title": "ParseResult",
  "type": "object"
}
