{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Project Id",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "snapshot_id"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "$id": "urn:qe-skill:1.0:oracle",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Id"
    },
    "claim": {
      "$ref": "#/$defs/Ref"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Id",
      "type": "string"
    },
    "inferred": {
      "title": "Inferred",
      "type": "boolean"
    },
    "invariant_claim": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "normative": {
      "title": "Normative",
      "type": "boolean"
    },
    "origin": {
      "enum": [
        "CONTRACT",
        "IMPLEMENTATION",
        "ORGANIZATIONAL_POLICY",
        "RISK",
        "EXPLORATORY"
      ],
      "title": "Origin",
      "type": "string"
    },
    "project_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Snapshot Id",
      "type": "string"
    },
    "statement": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Statement",
      "type": "string"
    },
    "usage": {
      "enum": [
        "acceptance",
        "characterization",
        "exploration"
      ],
      "title": "Usage",
      "type": "string"
    }
  },
  "required": [
    "id",
    "project_id",
    "snapshot_id",
    "statement",
    "origin",
    "claim",
    "normative",
    "inferred",
    "confidence",
    "usage"
  ],
  "title": "Oracle",
  "type": "object"
}
