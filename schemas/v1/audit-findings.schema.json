{
  "$defs": {
    "AuditFinding": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "classification": {
          "anyOf": [
            {
              "enum": [
                "VALID_AS_IS",
                "VALID_WITH_IMPROVEMENT",
                "PARTIAL_COVERAGE",
                "AMBIGUOUS",
                "BLOCKED_BY_SOURCE",
                "DUPLICATE_INTENTIONAL",
                "DUPLICATE_REDUNDANT",
                "CONFLICTING",
                "STALE",
                "OBSOLETE_CANDIDATE",
                "UNTRACEABLE",
                "NON_EXECUTABLE"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Classification"
        },
        "confidence": {
          "enum": [
            "DETERMINISTIC",
            "REVIEW_REQUIRED"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "human_clarification_required": {
          "title": "Human Clarification Required",
          "type": "boolean"
        },
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "impacted": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Impacted",
          "type": "array"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "project_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Project Id",
          "type": "string"
        },
        "proposed_action": {
          "minLength": 1,
          "title": "Proposed Action",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "INFO",
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ],
          "title": "Severity",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Snapshot Id",
          "type": "string"
        },
        "supporting_evidence": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Supporting Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "project_id",
        "snapshot_id",
        "asset",
        "kind",
        "rationale",
        "supporting_evidence",
        "impacted",
        "severity",
        "confidence",
        "proposed_action",
        "human_clarification_required"
      ],
      "title": "AuditFinding",
      "type": "object"
    },
    "OracleSupportFinding": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Evidence",
          "type": "array"
        },
        "expected_result_index": {
          "minimum": 0,
          "title": "Expected Result Index",
          "type": "integer"
        },
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "oracle": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Project Id",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Snapshot Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "SUPPORTED",
            "SUPPORTED_BUT_GROUPED",
            "IMPLEMENTATION_DERIVED_ONLY",
            "CONFLICTING",
            "STALE",
            "AMBIGUOUS",
            "UNSUPPORTED",
            "BLOCKED_BY_SOURCE"
          ],
          "title": "Status",
          "type": "string"
        },
        "test": {
          "$ref": "#/$defs/Ref"
        }
      },
      "required": [
        "id",
        "project_id",
        "snapshot_id",
        "test",
        "oracle",
        "expected_result_index",
        "status",
        "rationale",
        "evidence"
      ],
      "title": "OracleSupportFinding",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Project Id",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "snapshot_id"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "$id": "urn:qe-skill:1.0:audit-findings",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/AuditFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "history_summary": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "integer"
        },
        "type": "object"
      },
      "title": "History Summary",
      "type": "object"
    },
    "id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Id",
      "type": "string"
    },
    "oracle_findings": {
      "items": {
        "$ref": "#/$defs/OracleSupportFinding"
      },
      "title": "Oracle Findings",
      "type": "array"
    },
    "project_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Snapshot Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "project_id",
    "snapshot_id",
    "findings",
    "oracle_findings",
    "history_summary"
  ],
  "title": "AuditFindings",
  "type": "object"
}
