{
  "$defs": {
    "CacheSourceBinding": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/Ref"
        },
        "source_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        }
      },
      "required": [
        "source",
        "source_hash"
      ],
      "title": "CacheSourceBinding",
      "type": "object"
    },
    "ProviderIdentity": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Adapter Version",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Model",
          "type": "string"
        },
        "model_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Model Version",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "model_version",
        "adapter_version"
      ],
      "title": "ProviderIdentity",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Project Id",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "snapshot_id"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "$id": "urn:qe-skill:1.0:semantic-cache-binding",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "configuration_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Configuration Hash",
      "type": "string"
    },
    "extractor_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Extractor Version",
      "type": "string"
    },
    "operation": {
      "enum": [
        "EXTRACT",
        "RELATE",
        "SYNTHESIZE",
        "PROBE_SCENARIOS"
      ],
      "title": "Operation",
      "type": "string"
    },
    "project_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Project Id",
      "type": "string"
    },
    "prompt_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Prompt Version",
      "type": "string"
    },
    "provider_identity": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderIdentity"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Hash",
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Snapshot Id",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/CacheSourceBinding"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "snapshot_id",
    "request_hash",
    "sources",
    "provider_identity",
    "operation",
    "prompt_version",
    "configuration_hash",
    "extractor_version"
  ],
  "title": "SemanticCacheBinding",
  "type": "object"
}
