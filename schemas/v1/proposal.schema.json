{
  "$defs": {
    "Operation": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/Ref"
        },
        "artifact_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Hash",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "idempotency_key": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Idempotency Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "create",
            "update",
            "link",
            "append",
            "promote_oracle"
          ],
          "title": "Kind",
          "type": "string"
        },
        "payload_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Payload Hash",
          "type": "string"
        },
        "preserve_history": {
          "const": true,
          "title": "Preserve History",
          "type": "boolean"
        },
        "target": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Target",
          "type": "string"
        },
        "target_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Target Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "target",
        "target_version",
        "artifact",
        "artifact_hash",
        "payload_hash",
        "preserve_history",
        "idempotency_key"
      ],
      "title": "Operation",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Project Id",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "snapshot_id"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "$id": "urn:qe-skill:1.0:proposal",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Id",
      "type": "string"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/Operation"
      },
      "minItems": 1,
      "title": "Operations",
      "type": "array"
    },
    "preview_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Preview Hash",
      "type": "string"
    },
    "project_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_snapshot": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Source Snapshot",
      "type": "string"
    },
    "target_snapshot": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Target Snapshot",
      "type": "string"
    }
  },
  "required": [
    "id",
    "project_id",
    "snapshot_id",
    "operations",
    "preview_hash",
    "source_snapshot",
    "target_snapshot"
  ],
  "title": "Proposal",
  "type": "object"
}
