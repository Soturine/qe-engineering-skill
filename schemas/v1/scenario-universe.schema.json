{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Project Id",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "snapshot_id"
      ],
      "title": "Ref",
      "type": "object"
    },
    "ScenarioDisposition": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "enum": [
            "SELECTED",
            "MERGED",
            "PARAMETERIZED_CANDIDATE",
            "COVERED_BY_ANOTHER_LAYER",
            "DEFERRED",
            "EXPLORATORY",
            "BLOCKED",
            "REJECTED_UNSUPPORTED_OR_REDUNDANT"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Project Id",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "scenario": {
          "$ref": "#/$defs/Ref"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "snapshot_id",
        "scenario",
        "disposition",
        "rationale"
      ],
      "title": "ScenarioDisposition",
      "type": "object"
    },
    "ScenarioRecord": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "channel": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "constraint_values": {
          "items": {
            "type": "string"
          },
          "title": "Constraint Values",
          "type": "array"
        },
        "data_partition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Partition"
        },
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "oracle": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "origin": {
          "enum": [
            "CONTRACT",
            "IMPLEMENTATION",
            "ORGANIZATIONAL_POLICY",
            "RISK",
            "EXPLORATORY"
          ],
          "title": "Origin",
          "type": "string"
        },
        "pre_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "project_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Project Id",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "readiness": {
          "enum": [
            "READY_FOR_M3",
            "REVIEW_REQUIRED",
            "EXPLORATORY",
            "BLOCKED"
          ],
          "title": "Readiness",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_atom": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_requirement": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_risk": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stimulus": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "technique": {
          "enum": [
            "CRITERION",
            "EQUIVALENCE_PARTITION",
            "BOUNDARY_VALUE",
            "DECISION_TABLE",
            "STATE_TRANSITION",
            "PAIRWISE",
            "RISK_PACK"
          ],
          "title": "Technique",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "snapshot_id",
        "origin",
        "technique",
        "rationale",
        "readiness"
      ],
      "title": "ScenarioRecord",
      "type": "object"
    }
  },
  "$id": "urn:qe-skill:1.0:scenario-universe",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dispositions": {
      "items": {
        "$ref": "#/$defs/ScenarioDisposition"
      },
      "title": "Dispositions",
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Project Id",
      "type": "string"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/ScenarioRecord"
      },
      "title": "Scenarios",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Snapshot Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "project_id",
    "snapshot_id",
    "scenarios",
    "dispositions"
  ],
  "title": "ScenarioUniverse",
  "type": "object"
}
