{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Project Id",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "project_id",
        "snapshot_id"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "$id": "urn:qe-skill:1.0:semantic-adjudication",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "conflict_preserved": {
      "title": "Conflict Preserved",
      "type": "boolean"
    },
    "facts_promoted": {
      "const": false,
      "default": false,
      "title": "Facts Promoted",
      "type": "boolean"
    },
    "human_review_required": {
      "title": "Human Review Required",
      "type": "boolean"
    },
    "id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Id",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "PRESERVE_BOTH",
        "PRESERVE_CONFLICT",
        "RECORD_REFINEMENT",
        "RECORD_SUPERSESSION",
        "RECORD_DEPLOYMENT_INSTANCE",
        "HUMAN_REVIEW_REQUIRED"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "project_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Project Id",
      "type": "string"
    },
    "provider_self_authorized": {
      "const": false,
      "default": false,
      "title": "Provider Self Authorized",
      "type": "boolean"
    },
    "relation": {
      "$ref": "#/$defs/Ref"
    },
    "relation_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Relation Hash",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Snapshot Id",
      "type": "string"
    },
    "winner": {
      "default": null,
      "title": "Winner",
      "type": "null"
    }
  },
  "required": [
    "id",
    "project_id",
    "snapshot_id",
    "relation",
    "relation_hash",
    "outcome",
    "human_review_required",
    "conflict_preserved"
  ],
  "title": "AdjudicationResult",
  "type": "object"
}
